#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "macros.dtsi"

#define U_TAPPING_TERM 200
#define CPI_CYCLE_FORWARD 1

// Four-value cycle: +3 is equivalent to -1 without the module's negative-index overflow.

#define CPI_CYCLE_BACKWARD 3

&lt {
    tapping-term-ms = <U_TAPPING_TERM>;
    quick-tap-ms = <U_TAPPING_TERM>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hrm_right: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow Mods Right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <13 14 15 16 17 25 26 27 28 29 37 38 39 40 41 48 49>;
        };

        hrm_left: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow Mods Left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <18 19 20 21 22 30 31 32 33 34 42 43 44 45 46 50 51>;
        };
    };

    combos {
        compatible = "zmk,combos";

        toggle_mouse_layer {
            bindings = <&tog 3>;
            key-positions = <51 22>;
        };

        return_base_layer {
            bindings = <&to 0>;
            key-positions = <18 51>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "QWERTY";
            bindings = <
&kp ESC              &kp NUMBER_1  &kp N2  &kp N3         &kp N4        &kp N5          &kp N6     &kp N7     &kp N8     &kp N9      &kp N0         &kp MINUS
&kp TAB              &kp Q         &kp W   &kp E          &kp R         &kp T           &kp Y      &kp U      &kp I      &kp O       &kp P          &kp EQUAL
&mt LSHIFT CAPSLOCK  &kp A         &kp S   &kp D          &kp F         &kp G           &kp H      &kp J      &kp K      &kp L       &kp SEMICOLON  &kp APOS
&kp LCTRL            &lt 2 Z       &kp X   &kp C          &kp V         &lt 1 B         &lt 1 N    &kp M      &kp COMMA  &kp PERIOD  &kp SLASH      &kp ENTER
                                           &kp BACKSPACE  &kp SPACE     &kp DEL         &mkp LCLK  &mkp RCLK
                                                          &kp LEFT_GUI  &kp LEFT_ALT    &tog 2
            >;
        };

        SYMBOLS {
            display-name = "SYMBOLS";
            bindings = <
&trans                &kp F1  &kp F2        &kp F3      &kp F4            &kp F5             &kp F6   &kp F7    &kp F8         &kp F9  &kp F10  &kp F11
&kp C_BRI_UP          &none   &kp K_PREV    &kp K_NEXT  &kp K_MUTE        &kp C_VOLUME_UP    &kp INS  &kp HOME  &kp PAGE_UP    &none   &none    &kp F12
&kp C_BRIGHTNESS_DEC  &none   &kp C_REWIND  &kp C_FF    &kp K_PLAY_PAUSE  &kp C_VOL_DN       &kp DEL  &kp END   &kp PAGE_DOWN  &none   &none    &none
&trans                &none   &none         &none       &none             &trans             &trans   &none     &none          &none   &none    &trans
                                            &trans      &trans            &trans             &trans   &trans
                                                        &trans            &trans             &trans
            >;
        };

        NAV_NUM {
            display-name = "NAV_NUM";
            bindings = <
&sys_reset   &none   &none  &none     &none           &kp PAGE_UP      &kp LC(X)        &none            &none            &kp KP_DIVIDE    &kp KP_MULTIPLY  &none
&bootloader  &none   &none  &none     &kp UP          &kp PAGE_DOWN    &kp LC(V)        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS        &none
&none        &none   &none  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT        &kp LC(C)        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS         &none
&trans       &trans  &none  &none     &none           &none            &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL        &none
                            &trans    &trans          &trans           &trans           &trans
                                      &trans          &trans           &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans      &trans             &trans           &trans  &trans    &trans   &trans                        &trans                         &trans  &trans  &trans
&trans  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans  &mo 5     &trans   &cpi_cycle CPI_CYCLE_FORWARD  &cpi_cycle CPI_CYCLE_BACKWARD  &trans  &trans  &trans
&trans  &trans      &trans             &trans           &trans  &trans    &trans   &mkp LCLK                     &mkp RCLK                      &trans  &trans  &trans
&trans  &trans      &trans             &trans           &trans  &trans    &trans   &trans                        &trans                         &trans  &trans  &trans
                                       &trans           &trans  &trans    &kp F11  &kp RC(UP_ARROW)
                                                        &trans  &trans    &trans
            >;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        KEYBOARD_CONTROLS {
            display-name = "KBD_CTRLS";
            bindings = <
&trans  &trans       &trans      &trans  &trans  &trans    &trans        &trans          &trans        &trans        &trans        &trans
&trans  &bootloader  &sys_reset  &trans  &trans  &trans    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans       &trans      &trans  &trans  &trans    &bt BT_CLR    &bt BT_CLR_ALL  &bt BT_NXT    &bt BT_PRV    &trans        &trans
&trans  &trans       &trans      &trans  &trans  &trans    &trans        &trans          &trans        &trans        &trans        &trans
                                 &trans  &trans  &trans    &trans        &trans
                                         &trans  &trans    &trans
            >;
        };
    };
};
